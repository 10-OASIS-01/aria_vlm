# Paths are relative to the project directory, or use your own absolute paths.
ARIA_MODEL_PATH=./models/Qwen3.5-9B
ARIA_ASR_MODEL_PATH=./models/faster-whisper-small
HF_HOME=./models/hf-cache
ARIA_DATA_DIR=./.runtime
CUDA_VISIBLE_DEVICES=0
ARIA_DEVICE=cuda:0
ARIA_HOST=127.0.0.1
ARIA_PORT=8785
ARIA_ROOT_PATH=
ARIA_MAX_PIXELS=307200
ARIA_INPUT_MODE=video
# Reject live frames older than this on arrival; 0 disables (e.g. unsynchronized clocks).
ARIA_MAX_FRAME_AGE_MS=5000
ARIA_SAVE_FRAMES=1
OMP_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false
# Optional bearer token for write endpoints. Also set it on the ROS host.
ARIA_API_TOKEN=
# The console's System row starts guidance_node and a camera from this aria2_ros2 workspace.
ARIA_ROS_WORKSPACE=../aria2_ros2
# Fast DDS profile with large buffers (empty: ROS default; 640x480 frames may drop).
ARIA_FASTDDS_PROFILE=
# Still image for the test camera (empty: a moving test pattern).
ARIA_FAKE_IMAGE=
